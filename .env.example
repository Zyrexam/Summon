# A Neon (or Neon-compatible) connection string. The web app uses Neon's HTTP
# driver, so a local Postgres over TCP is not reachable. Use the pooled
# endpoint (-pooler) for serverless.
DATABASE_URL=

# HMAC key for session tokens. Required in production: the built-in default is
# published in the README, so anyone could mint a valid token with it.
TOKEN_SECRET=

# Provider key for @ai
GROQ_API_KEY=

# Model used for @ai answers.
SUMMON_MODEL=openai/gpt-oss-120b

# Set to true ONLY when a proxy you control sets x-forwarded-for. Left false,
# that header is whatever the client typed, so the per-IP rate limit shares a
# single bucket instead of trusting it.
TRUST_PROXY=false

# Relay port, and the URL the browser uses to reach it.
PORT=8787
NEXT_PUBLIC_SIGNAL_URL=ws://127.0.0.1:8787