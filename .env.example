# Backend only (Render). The relay owns the only database pool. Use the pooled
# Neon endpoint (-pooler). Vercel never sees this.
DATABASE_URL=

# Backend only (Render). HMAC key for session tokens, shared with nobody else
# now: the backend both signs (auth API) and verifies (relay) tokens. Required
# in production: the built-in default is published in the README, so anyone
# could mint a valid token with it.
TOKEN_SECRET=

# Backend only (Render). Provider key for @ai
GROQ_API_KEY=

# Backend only (Render). Model used for @ai answers.
SUMMON_MODEL=openai/gpt-oss-120b

# Backend only (Render). Set to true behind Render so x-forwarded-for is
# trusted for per-IP rate limits. Left false, that header is whatever the
# client typed, so the per-IP rate limit shares a single bucket instead.
TRUST_PROXY=false

# Backend only (Render). Relay port (Render injects PORT; 8787 is local dev).
PORT=8787

# The ONLY variable Vercel needs. The browser derives both the WS relay URL
# and the auth API base (https://host) from it.
# Local: ws://127.0.0.1:8787 — Production: wss://<render-service>.onrender.com
NEXT_PUBLIC_SIGNAL_URL=ws://127.0.0.1:8787
